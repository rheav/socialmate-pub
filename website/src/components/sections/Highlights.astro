---
import { Code2, Languages, ShieldCheck } from "@lucide/astro";
import { ShineBorder } from "../magicui/shine-border";
import { getLangFromUrl, useTranslations } from "../../i18n/ui";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section class="py-24 px-6 bg-bg-card/50">
  <div class="max-w-6xl mx-auto grid gap-6 lg:grid-cols-3">
    <article class="relative overflow-hidden rounded-2xl bg-theme-card border border-theme p-8 lg:col-span-3 lg:flex lg:items-center lg:gap-10">
      <ShineBorder borderWidth={2} duration={12} />
      <ShieldCheck size={44} stroke-width={1.25} class="text-accent-from shrink-0 mb-5 lg:mb-0" aria-hidden="true" />
      <div>
        <h2 class="text-2xl md:text-3xl font-bold mb-3">{t("hl.privacy.title")}</h2>
        <p class="text-theme-muted leading-relaxed max-w-3xl">{t("hl.privacy.text")}</p>
      </div>
    </article>

    <article class="rounded-2xl bg-theme-card border border-theme p-7 lg:col-span-2">
      <Code2 size={26} stroke-width={1.5} class="text-accent-from mb-4" aria-hidden="true" />
      <h3 class="text-xl font-semibold mb-2">{t("hl.open.title")}</h3>
      <p class="text-theme-muted leading-relaxed">{t("hl.open.text")}</p>
    </article>

    <article class="rounded-2xl bg-theme-card border border-theme p-7">
      <Languages size={26} stroke-width={1.5} class="text-accent-from mb-4" aria-hidden="true" />
      <h3 class="text-xl font-semibold mb-2">{t("hl.lang.title")}</h3>
      <p class="text-theme-muted leading-relaxed">{t("hl.lang.text")}</p>
    </article>
  </div>
</section>
