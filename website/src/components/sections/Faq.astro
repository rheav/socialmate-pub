---
// FAQ with native <details> (no JS). The page passes the same items to Layout for FAQPage JSON-LD.
import { ChevronDown } from "@lucide/astro";
import type { FaqItem } from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/ui";

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="faq" class="py-24 px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="section-header-animate text-3xl md:text-4xl font-bold text-center mb-12" data-animate>
      {t("faq.title")} <span class="gradient-text-accent">{t("faq.titleAccent")}</span>
    </h2>
    <div class="divide-y divide-[var(--color-border)] border-y border-theme">
      {
        items.map(({ q, a }) => (
          <details class="faq-item group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left font-semibold">
              {q}
              <ChevronDown size={18} class="shrink-0 text-theme-muted transition-transform group-open:rotate-180" aria-hidden="true" />
            </summary>
            <p class="mt-3 text-theme-muted leading-relaxed">{a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
