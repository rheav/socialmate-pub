---
// The Spy, shown rather than told: the dashboard page and the side panel, side by side.
import { Check } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "../../i18n/ui";

const t = useTranslations(getLangFromUrl(Astro.url));
const points = [1, 2, 3, 4].map((n) => t(`spy.point${n}` as "spy.point1"));
---

<section id="spy" class="py-24 px-6 bg-bg-card/50">
  <div class="max-w-6xl mx-auto">
    <div class="section-header-animate text-center mb-14" data-animate>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        {t("spy.title")} <span class="gradient-text-accent">{t("spy.titleAccent")}</span>
      </h2>
      <p class="text-theme-muted max-w-2xl mx-auto">{t("spy.subtitle")}</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px] items-start">
      <figure class="card-animate rounded-2xl overflow-hidden border border-theme shadow-2xl" data-animate>
        <img src="/images/shots/dash-sheet.png" alt={t("spy.shot.dashboard")} width="1440" height="900" loading="lazy" class="w-full" />
      </figure>
      <div class="space-y-6">
        <figure class="card-animate rounded-2xl overflow-hidden border border-theme shadow-xl max-h-[420px]" data-animate>
          <img src="/images/shots/panel-spy.png" alt={t("spy.shot.panel")} width="800" height="1560" loading="lazy" class="w-full object-cover object-top" />
        </figure>
        <ul class="space-y-3">
          {
            points.map((p) => (
              <li class="flex gap-3 text-sm text-theme-muted leading-relaxed">
                <Check size={18} class="text-accent-from shrink-0 mt-0.5" aria-hidden="true" />
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
