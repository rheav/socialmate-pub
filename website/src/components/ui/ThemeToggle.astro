---
/**
 * Light / dark switch. Vanilla port of Magic UI AnimatedThemeToggler (circle reveal
 * through the View Transitions API); writes the `theme` cookie. Dark is the default,
 * like the extension's panel.
 */
import { Moon, Sun } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "../../i18n/ui";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<button
  type="button"
  class="theme-toggle-btn inline-flex size-10 items-center justify-center rounded-xl border border-theme bg-theme-card text-theme-muted hover:text-theme cursor-pointer"
  data-to-light={t("theme.toLight")}
  data-to-dark={t("theme.toDark")}
  title={t("theme.label")}
>
  <Sun class="theme-icon-sun size-[18px]" aria-hidden="true" />
  <Moon class="theme-icon-moon size-[18px]" aria-hidden="true" />
  <span class="theme-action sr-only"></span>
</button>

<style is:global>
  :root.light .theme-icon-sun,
  :root:not(.light) .theme-icon-moon {
    display: none;
  }
</style>

<script is:inline>
  (function () {
    if (window.__themeToggleInitialized) return;
    window.__themeToggleInitialized = true;

    function getTheme() {
      var m = document.cookie.match(/(?:^|;\s*)theme=(dark|light)/);
      return m ? m[1] : "dark";
    }

    function writeCookie(theme) {
      var dom = "";
      document.cookie = "theme=" + theme + "; path=/; max-age=31536000; samesite=lax" + dom;
    }

    function label() {
      var isLight = document.documentElement.classList.contains("light");
      document.querySelectorAll(".theme-toggle-btn").forEach(function (b) {
        var action = b.querySelector(".theme-action");
        if (action) action.textContent = isLight ? b.dataset.toDark : b.dataset.toLight;
      });
    }

    function apply(theme) {
      document.documentElement.classList.toggle("light", theme === "light");
      writeCookie(theme);
      label();
    }

    // Circle reveal from the button (AnimatedThemeToggler, "circle" variant).
    function toggle(button) {
      var next = getTheme() === "dark" ? "light" : "dark";
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || typeof document.startViewTransition !== "function") return apply(next);

      var vw = window.innerWidth, vh = window.innerHeight;
      var r = button.getBoundingClientRect();
      var x = r.left + r.width / 2, y = r.top + r.height / 2;
      var maxRadius = Math.hypot(Math.max(x, vw - x), Math.max(y, vh - y));
      var at = (x / vw) * 100 + "% " + (y / vh) * 100 + "%";
      var radius = (maxRadius / (Math.hypot(vw, vh) / Math.SQRT2)) * 100 + "%";
      var from = "circle(0% at " + at + ")";
      var to = "circle(" + radius + " at " + at + ")";

      var root = document.documentElement;
      root.dataset.themeVt = "active";
      root.style.setProperty("--theme-vt-clip-from", from);
      var transition = document.startViewTransition(function () {
        apply(next);
      });
      transition.ready
        .then(function () {
          root.animate({ clipPath: [from, to] }, { duration: 450, easing: "ease-in-out", fill: "forwards", pseudoElement: "::view-transition-new(root)" });
        })
        .catch(function () {});
      transition.finished.finally(function () {
        delete root.dataset.themeVt;
        root.style.removeProperty("--theme-vt-clip-from");
      });
    }

    apply(getTheme());

    document.addEventListener("click", function (e) {
      var button = e.target.closest(".theme-toggle-btn");
      if (!button) return;
      e.preventDefault();
      toggle(button);
    });

    document.addEventListener("astro:after-swap", function () {
      apply(getTheme());
    });
  })();
</script>
